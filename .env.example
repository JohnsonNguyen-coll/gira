TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Optional comma-separated list. When set, replaces RPC_URL and the default pool.
# Default: official RPC -> PublicNode -> BlockVectra public (limited methods/3 req/s).
RPC_URLS=https://rpc.mainnet.chain.robinhood.com,https://robinhood-rpc.publicnode.com,https://api.blockvectra.com/v1/robinhood_mainnet/public
RPC_TIMEOUT_SECONDS=3
RPC_COOLDOWN_SECONDS=15
PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# Start with a simulation. Set false only when ready to send real transactions.
DRY_RUN=true
POLL_SECONDS=0.5
MAX_LAUNCH_AGE_SECONDS=60
SLIPPAGE_BPS=300
MAX_GAS_PRICE_GWEI=20
MAX_GAS_LIMIT=1500000
# Local: data. Railway: /data, with a persistent volume mounted at /data.
DATA_DIR=data
